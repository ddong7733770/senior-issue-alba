#!/bin/bash
# -------------------------------------------------------------
# 🚀 더블 클릭 한 번으로 깃허브에 사이트를 업로드하는 자동 실행 프로그램
# -------------------------------------------------------------

echo "====================================================="
echo "📌 [오늘의 기준] 사이트 업데이트를 시작합니다..."
echo "====================================================="

# 현재 폴더로 이동
cd "$(dirname "$0")"

# 변경된 내용 저장
git add .

# 오늘 날짜와 시간으로 업데이트 메시지 작성
NOW=$(date "+%Y-%m-%d %H:%M:%S")
git commit -m "사이트 내용 업데이트 ($NOW)"

# 깃허브로 보냄
echo "🌐 깃허브로 수정 사항을 보내는 중입니다..."
git push

echo "====================================================="
echo "✅ 업데이트가 완료되었습니다!"
echo "📱 약 10초 뒤에 스마트폰과 PC에서 수정된 내용을 바로 확인하실 수 있습니다."
echo "====================================================="
echo "이 창을 닫으셔도 됩니다."
